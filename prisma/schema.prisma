generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  MANAGER
  KITCHEN
  WAITER
  CASHIER
  SUPER_ADMIN
}

enum SessionStatus {
  ACTIVE
  CLOSED
  EXPIRED
}

enum OrderStatus {
  OPEN
  PAYMENT_PENDING
  PAID
  CANCELLED
}

enum PaymentStatus {
  CREATED
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum KotState {
  QUEUED
  IN_PROGRESS
  READY
  SERVED
}

enum StaffStatus {
  ACTIVE
  INVITED
  DISABLED
}

model Restaurant {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  address           String?
  gstNumber         String?
  gatewayAccountId  String?
  currency          String             @default("INR")
  taxRate           Decimal            @default(5)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  users             User[]
  tables            RestaurantTable[]
  categories        MenuCategory[]
  menuItems         MenuItem[]
  sessions          Session[]
  orders            Order[]
  payments          Payment[]
  kots              Kot[]
  dailyStats        DailyRestaurantStat[]
  auditLogs         AuditLog[]
}

model User {
  id           String       @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  email        String       @unique
  passwordHash String
  role         UserRole
  status       StaffStatus  @default(ACTIVE)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  auditLogs    AuditLog[]
}

model RestaurantTable {
  id           String      @id @default(cuid())
  restaurantId String
  restaurant   Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  label        String
  qrSecret     String
  seats        Int         @default(4)
  active       Boolean     @default(true)
  sessions     Session[]
  createdAt    DateTime    @default(now())
  @@unique([restaurantId, label])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  sortOrder    Int        @default(0)
  items        MenuItem[]
}

model MenuItem {
  id             String        @id @default(cuid())
  restaurantId   String
  restaurant    Restaurant     @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  price          Decimal       @db.Decimal(12,2)
  station        String        @default("GENERAL")
  basePrepTime   Int           @default(10)
  isAvailable    Boolean       @default(true)
  imageUrl       String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  orderItems     OrderItem[]
  @@index([restaurantId])
}

model Session {
  id           String          @id @default(cuid())
  restaurantId String
  restaurant   Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tableId      String
  table         RestaurantTable @relation(fields: [tableId], references: [id], onDelete: Cascade)
  startedAt    DateTime        @default(now())
  expiresAt    DateTime
  lastActivity DateTime        @default(now())
  status       SessionStatus   @default(ACTIVE)
  orders       Order[]
  @@index([tableId, status])
}

model Order {
  id            String        @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  sessionId     String
  session       Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  status        OrderStatus   @default(OPEN)
  subtotal      Decimal       @db.Decimal(12,2)
  tax           Decimal       @db.Decimal(12,2)
  total         Decimal       @db.Decimal(12,2)
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  items         OrderItem[]
  payment       Payment?
  kots          Kot[]
  @@index([sessionId])
  @@index([status])
}

model OrderItem {
  id          String    @id @default(cuid())
  orderId     String
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId  String
  menuItem    MenuItem  @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  priceSnapshot Decimal @db.Decimal(12,2)
  quantity    Int
  notes       String?
  station     String
  createdAt   DateTime  @default(now())
}

model Payment {
  id                 String        @id @default(cuid())
  restaurantId       String
  restaurant         Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId            String        @unique
  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  gatewayPaymentId   String?       @unique
  gatewayOrderId     String?
  amount             Decimal       @db.Decimal(12,2)
  status             PaymentStatus @default(CREATED)
  webhookReceivedAt  DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
}

model Kot {
  id          String     @id @default(cuid())
  restaurantId String
  restaurant  Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderId     String
  order       Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  station     String
  state       KotState   @default(QUEUED)
  eta         DateTime?
  priority    Int        @default(0)
  delayed     Boolean    @default(false)
  startedAt   DateTime?
  readyAt     DateTime?
  servedAt    DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  @@index([restaurantId, station, state])
}

model DailyRestaurantStat {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  date         DateTime
  revenue      Decimal    @db.Decimal(12,2)
  orderCount   Int
  aov          Decimal    @db.Decimal(12,2)
  peakHour     Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  @@unique([restaurantId, date])
}

model AuditLog {
  id           String      @id @default(cuid())
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  action       String
  entity       String
  entityId     String?
  metadata     Json?
  createdAt    DateTime    @default(now())
  @@index([restaurantId, createdAt])
}
